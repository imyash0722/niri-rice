# Dynamic Material Design 3 theme for btop generated by Matugen
# Matching system wallpaper palette

# Main background, empty for terminal default transparency
theme[main_bg]=""

# Main text color
theme[main_fg]="#ecdfe5"

# Title color for boxes
theme[title]="#f4b2e2"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#f5b9a4"

# Background color of selected item in processes box
theme[selected_bg]="#f4b2e2"

# Foreground color of selected item in processes box
theme[selected_fg]="#4e1e46"

# Color of inactive/disabled text
theme[inactive_fg]="#9b8d95"

# Color of text appearing on top of graphs
theme[graph_text]="#d2c2ca"

# Background color of the percentage meters
theme[meter_bg]="#3a3337"

# Misc colors for processes box
theme[proc_misc]="#dcbed1"

# Box outlines
theme[cpu_box]="#4e444a"
theme[mem_box]="#4e444a"
theme[net_box]="#4e444a"
theme[proc_box]="#4e444a"
theme[div_line]="#4e444a"

# Temperature graph colors (Cool -> Warm -> Hot)
theme[temp_start]="#8fccff"
theme[temp_mid]="#e8ab6e"
theme[temp_end]="#ffb4ab"

# CPU graph colors
theme[cpu_start]="#f4b2e2"
theme[cpu_mid]="#dcbed1"
theme[cpu_end]="#f5b9a4"

# Mem/Disk free meter
theme[free_start]="#a6cd63"
theme[free_mid]="#dcbed1"
theme[free_end]="#f4b2e2"

# Mem/Disk cached meter
theme[cached_start]="#dcbed1"
theme[cached_mid]="#f4b2e2"
theme[cached_end]="#f5b9a4"

# Mem/Disk available meter
theme[available_start]="#8fccff"
theme[available_mid]="#f4b2e2"
theme[available_end]="#dcbed1"

# Mem/Disk used meter
theme[used_start]="#f4b2e2"
theme[used_mid]="#f5b9a4"
theme[used_end]="#ffb4ab"

# Download graph colors
theme[download_start]="#f4b2e2"
theme[download_mid]="#dcbed1"
theme[download_end]="#f5b9a4"

# Upload graph colors
theme[upload_start]="#f5b9a4"
theme[upload_mid]="#dcbed1"
theme[upload_end]="#f4b2e2"

# Process box color gradient
theme[process_start]="#f4b2e2"
theme[process_mid]="#dcbed1"
theme[process_end]="#ffb4ab"

# Dynamic Material Design 3 theme for btop generated by Matugen
# Matching system wallpaper palette

# Main background, empty for terminal default transparency
theme[main_bg]=""

# Main text color
theme[main_fg]="#efe0d5"

# Title color for boxes
theme[title]="#feb877"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#c2cc98"

# Background color of selected item in processes box
theme[selected_bg]="#feb877"

# Foreground color of selected item in processes box
theme[selected_fg]="#4b2800"

# Color of inactive/disabled text
theme[inactive_fg]="#9e8e82"

# Color of text appearing on top of graphs
theme[graph_text]="#d5c3b6"

# Background color of the percentage meters
theme[meter_bg]="#3c332c"

# Misc colors for processes box
theme[proc_misc]="#e2c0a5"

# Box outlines
theme[cpu_box]="#51443a"
theme[mem_box]="#51443a"
theme[net_box]="#51443a"
theme[proc_box]="#51443a"
theme[div_line]="#51443a"

# Temperature graph colors (Cool -> Warm -> Hot)
theme[temp_start]="#7bcffe"
theme[temp_mid]="#e2ae69"
theme[temp_end]="#ffb4ab"

# CPU graph colors
theme[cpu_start]="#feb877"
theme[cpu_mid]="#e2c0a5"
theme[cpu_end]="#c2cc98"

# Mem/Disk free meter
theme[free_start]="#abcc5f"
theme[free_mid]="#e2c0a5"
theme[free_end]="#feb877"

# Mem/Disk cached meter
theme[cached_start]="#e2c0a5"
theme[cached_mid]="#feb877"
theme[cached_end]="#c2cc98"

# Mem/Disk available meter
theme[available_start]="#7bcffe"
theme[available_mid]="#feb877"
theme[available_end]="#e2c0a5"

# Mem/Disk used meter
theme[used_start]="#feb877"
theme[used_mid]="#c2cc98"
theme[used_end]="#ffb4ab"

# Download graph colors
theme[download_start]="#feb877"
theme[download_mid]="#e2c0a5"
theme[download_end]="#c2cc98"

# Upload graph colors
theme[upload_start]="#c2cc98"
theme[upload_mid]="#e2c0a5"
theme[upload_end]="#feb877"

# Process box color gradient
theme[process_start]="#feb877"
theme[process_mid]="#e2c0a5"
theme[process_end]="#ffb4ab"

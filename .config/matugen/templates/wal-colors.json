{
    "wallpaper": "{{ image }}",
    "alpha": "100",

    "special": {
        "background": "{{ colors.background.default.hex }}",
        "foreground": "{{ colors.on_surface.default.hex }}",
        "cursor": "{{ colors.primary.default.hex }}"
    },
    "colors": {
        "color0": "{{ colors.surface.default.hex }}",
        "color1": "{{ "#F7768E" | to_color | blend: {{ colors.primary.default.hex | to_color }}, 0.15 | format: "hex" }}",
        "color2": "{{ "#9ECE6A" | to_color | blend: {{ colors.primary.default.hex | to_color }}, 0.15 | format: "hex" }}",
        "color3": "{{ "#E0AF68" | to_color | blend: {{ colors.primary.default.hex | to_color }}, 0.15 | format: "hex" }}",
        "color4": "#7AA2F7",
        "color5": "{{ colors.primary.default.hex }}",
        "color6": "#7DCFFF",
        "color7": "{{ colors.on_surface.default.hex }}",
        "color8": "{{ colors.outline.default.hex }}",
        "color9": "#FF7A93",
        "color10": "#B9F27C",
        "color11": "#FF9E64",
        "color12": "#89B4FA",
        "color13": "{{ colors.tertiary.default.hex }}",
        "color14": "#B4F9F8",
        "color15": "#FFFFFF"
    }
}

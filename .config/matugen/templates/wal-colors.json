{
    "wallpaper": "{{ image }}",
    "alpha": "100",

    "special": {
        "background": "{{ colors.background.default.hex }}",
        "foreground": "{{ colors.on_surface.default.hex }}",
        "cursor": "{{ colors.primary.default.hex }}"
    },
    "colors": {
        "color0": "{{ colors.surface.default.hex }}",
        "color1": "{{ "#F7768E" | to_color | blend: {{ colors.primary.default.hex | to_color }}, 0.15 | format: "hex" }}",
        "color2": "{{ "#9ECE6A" | to_color | blend: {{ colors.primary.default.hex | to_color }}, 0.15 | format: "hex" }}",
        "color3": "{{ "#E0AF68" | to_color | blend: {{ colors.primary.default.hex | to_color }}, 0.15 | format: "hex" }}",
        "color4": "{{ colors.primary.default.hex }}",
        "color5": "{{ "#BB9AF7" | to_color | blend: {{ colors.primary.default.hex | to_color }}, 0.15 | format: "hex" }}",
        "color6": "{{ "#7DCFFF" | to_color | blend: {{ colors.primary.default.hex | to_color }}, 0.15 | format: "hex" }}",
        "color7": "{{ colors.on_surface.default.hex }}",
        "color8": "{{ colors.surface_container_highest.default.hex }}",
        "color9": "{{ "#FF7A93" | to_color | blend: {{ colors.primary.default.hex | to_color }}, 0.15 | format: "hex" }}",
        "color10": "{{ "#B9F27C" | to_color | blend: {{ colors.primary.default.hex | to_color }}, 0.15 | format: "hex" }}",
        "color11": "{{ "#FF9E64" | to_color | blend: {{ colors.primary.default.hex | to_color }}, 0.15 | format: "hex" }}",
        "color12": "{{ colors.primary.default.hex }}",
        "color13": "{{ "#DDB6F2" | to_color | blend: {{ colors.primary.default.hex | to_color }}, 0.15 | format: "hex" }}",
        "color14": "{{ "#B4F9F8" | to_color | blend: {{ colors.primary.default.hex | to_color }}, 0.15 | format: "hex" }}",
        "color15": "{{ colors.on_surface.default.hex }}"
    }
}

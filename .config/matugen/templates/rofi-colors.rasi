* {
    bg0: {{ colors.background.default.hex }};
    bg0-alpha: {{ colors.background.default.hex }}e6;
    bg1: {{ colors.surface.default.hex }};
    bg2: {{ colors.surface_container_high.default.hex }};
    fg0: {{ colors.on_surface.default.hex }};
    fg1: {{ colors.on_surface_variant.default.hex }};
    accent-color: {{ colors.primary.default.hex }};
    accent-container: {{ colors.primary_container.default.hex }};
    accent-fg: {{ colors.on_primary.default.hex }};
    urgent-color: {{ colors.error.default.hex }};
    border-color: {{ colors.primary.default.hex }};
}


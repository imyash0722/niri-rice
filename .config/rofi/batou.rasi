@import "colors.rasi"

* {
    font: "Inter, JetBrainsMono Nerd Font 11";
    background-color: transparent;
    text-color: @fg0;
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    location: center;
    anchor: center;
    width: 420px;
    border: 2px;
    border-color: @accent-color;
    border-radius: 10px;
    background-color: @bg0-alpha;
    padding: 10px;
}

mainbox {
    spacing: 8px;
    children: [ inputbar, message, listview ];
}

inputbar {
    spacing: 8px;
    padding: 6px 10px;
    border: 1px;
    border-color: rgba(255, 255, 255, 0.10);
    border-radius: 6px;
    background-color: rgba(255, 255, 255, 0.05);
    children: [ prompt, entry ];
}

prompt {
    text-color: @accent-color;
    font: "Inter, JetBrainsMono Nerd Font Bold 11";
}

entry {
    placeholder: "Search...";
    placeholder-color: rgba(255, 255, 255, 0.35);
    text-color: @fg0;
}

message {
    padding: 4px 6px;
    border-radius: 6px;
    background-color: rgba(255, 255, 255, 0.05);
}

textbox {
    text-color: @fg0;
}

listview {
    padding: 2px 0;
    lines: 7;
    columns: 1;
    spacing: 2px;
    fixed-height: false;
    scrollbar: false;
}

element {
    padding: 5px 8px;
    spacing: 8px;
    border-radius: 6px;
    border: 1px;
    border-color: transparent;
    cursor: pointer;
}

element normal.normal, element alternate.normal {
    text-color: @fg0;
    background-color: transparent;
}

element selected.normal, element selected.active {
    background-color: rgba(255, 255, 255, 0.12);
    border-color: @accent-color;
    text-color: @accent-color;
}

element normal.active, element alternate.active {
    text-color: @accent-color;
}

element normal.urgent, element alternate.urgent {
    text-color: @urgent-color;
}

element selected.urgent {
    background-color: @urgent-color;
    text-color: #0c110d;
}

element-icon {
    size: 20px;
    horizontal-align: 0.5;
    vertical-align: 0.5;
}

element-text {
    text-color: inherit;
    font: "Inter, JetBrainsMono Nerd Font Medium 11";
    vertical-align: 0.5;
}

element selected element-text {
    font: "Inter, JetBrainsMono Nerd Font Bold 11";
}

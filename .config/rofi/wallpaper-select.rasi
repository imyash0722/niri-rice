/**
 * Ultra-Modern Glassmorphic Wallpaper Grid with Floating Frosted Nameplates
 **/

@import "colors.rasi"

* {
    font: "JetBrainsMono Nerd Font 11";
    background-color: transparent;
    text-color: @fg0;
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    location: center;
    anchor: center;
    width: 78%;
    height: 84%;
    x-offset: 0;
    y-offset: 0;

    border: 2px;
    border-color: @accent-color;
    border-radius: 14px;
    background-color: rgba(8, 14, 20, 0.92);
}

mainbox {
    spacing: 14px;
    padding: 18px;
    children: [ inputbar, listview ];
}

inputbar {
    spacing: 10px;
    padding: 8px 16px;
    border: 1px;
    border-color: rgba(255, 255, 255, 0.10);
    border-radius: 10px;
    background-color: rgba(255, 255, 255, 0.04);
    children: [ prompt, entry ];
}

prompt {
    text-color: @accent-color;
    font: "JetBrainsMono Nerd Font Bold 12";
}

entry {
    placeholder: "Search wallpapers or scroll...";
    placeholder-color: rgba(255, 255, 255, 0.35);
    text-color: @fg0;
}

listview {
    columns: 4;
    lines: 3;
    flow: horizontal;
    spacing: 12px;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    fixed-height: true;
}

element {
    orientation: vertical;
    padding: 0;
    margin: 0;
    spacing: -38px;
    border-radius: 10px;
    border: 2px;
    border-color: rgba(255, 255, 255, 0.08);
    background-color: rgba(0, 0, 0, 0.35);
    cursor: pointer;
}

element selected.normal, element selected.active {
    border-color: @accent-color;
    background-color: rgba(255, 255, 255, 0.06);
}

element-icon {
    size: 200px;
    border-radius: 8px;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    expand: true;
}

element-text {
    horizontal-align: 0.5;
    vertical-align: 0.5;
    text-color: @fg0;
    font: "JetBrainsMono Nerd Font Bold 10";
    padding: 6px 12px;
    margin: 0 10px 8px 10px;
    border-radius: 6px;
    background-color: rgba(6, 12, 16, 0.82);
    border: 1px;
    border-color: rgba(255, 255, 255, 0.14);
}

element selected element-text {
    text-color: @accent-color;
    background-color: rgba(6, 12, 16, 0.94);
    border-color: @accent-color;
}

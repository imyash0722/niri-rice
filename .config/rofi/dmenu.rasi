/**
 * Modern Glassmorphic Capsule Dmenu Theme
 * Used for Clipboard, Wi-Fi, SSH, Power Profiles, Bookmarks
 * Material You dynamic tinting via colors.rasi
 **/

@import "colors.rasi"

* {
    background-color:           transparent;
    text-color:                 @fg0;
    margin:                     0px;
    padding:                    0px;
    spacing:                    0px;
}

window {
    transparency:               "real";
    location:                   center;
    anchor:                     center;
    fullscreen:                 false;
    width:                      580px;
    x-offset:                   0px;
    y-offset:                   0px;

    enabled:                    true;
    border:                     2px;
    border-color:               @accent-color;
    border-radius:              16px;
    background-color:           @bg0-alpha;
    cursor:                     "default";
}

mainbox {
    enabled:                    true;
    spacing:                    10px;
    padding:                    16px;
    background-color:           transparent;
    children:                   [ "inputbar", "listview" ];
}

inputbar {
    enabled:                    true;
    spacing:                    10px;
    padding:                    9px 14px;
    border:                     1px;
    border-color:               rgba(255, 255, 255, 0.10);
    border-radius:              10px;
    background-color:           rgba(255, 255, 255, 0.04);
    text-color:                 @fg0;
    children:                   [ "prompt", "entry" ];
}

prompt {
    enabled:                    true;
    background-color:           transparent;
    text-color:                 @accent-color;
    font:                       "JetBrainsMono Nerd Font Bold 11";
}

entry {
    enabled:                    true;
    background-color:           transparent;
    text-color:                 @fg0;
    cursor:                     text;
    placeholder:                "Filter...";
    placeholder-color:          @fg1;
    font:                       "Inter 11";
}

listview {
    enabled:                    true;
    columns:                    1;
    lines:                      8;
    cycle:                      true;
    dynamic:                    true;
    scrollbar:                  false;
    layout:                     vertical;
    reverse:                    false;
    fixed-height:               false;
    fixed-columns:              true;
    spacing:                    4px;
    background-color:           transparent;
    text-color:                 @fg0;
    cursor:                     "default";
}

element {
    enabled:                    true;
    spacing:                    10px;
    padding:                    7px 12px;
    border:                     1px;
    border-color:               transparent;
    border-radius:              8px;
    background-color:           transparent;
    text-color:                 @fg0;
    cursor:                     pointer;
}

element normal.normal, element alternate.normal {
    background-color:           transparent;
    text-color:                 @fg0;
}

element selected.normal, element selected.active {
    background-color:           @accent-container;
    border-color:               @accent-color;
    text-color:                 @fg0;
}

element-icon {
    background-color:           transparent;
    text-color:                 inherit;
    size:                       22px;
    cursor:                     inherit;
}

element-text {
    background-color:           transparent;
    text-color:                 inherit;
    highlight:                  inherit;
    cursor:                     inherit;
    vertical-align:             0.5;
    horizontal-align:           0.0;
    font:                       "Inter, JetBrainsMono Nerd Font Medium 11";
}

element selected.normal element-text {
    font:                       "Inter, JetBrainsMono Nerd Font Bold 11";
}

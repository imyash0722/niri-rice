{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "application",
  "control-center-margin-top": 12,
  "control-center-margin-bottom": 12,
  "control-center-margin-right": 12,
  "control-center-margin-left": 0,
  "notification-2nd-benchmark": false,
  "control-center-width": 380,
  "control-center-height": 840,
  "fit-to-screen": false,
  "notification-window-width": 360,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": true,
  "scripts": {},
  "notification-visibility": {},
  "widgets": [
    "title",
    "dnd",
    "mpris",
    "volume",
    "backlight",
    "buttons-grid",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "Control Center",
      "clear-all-button": true,
      "button-text": "Clear All"
    },
    "dnd": {
      "text": "Do Not Disturb"
    },
    "mpris": {
      "image-size": 84,
      "image-radius": 12
    },
    "volume": {
      "label": "󰕾",
      "show-per-app": true
    },
    "backlight": {
      "label": "󰃠",
      "device": "amdgpu_bl1"
    },
    "buttons-grid": {
      "actions": [
        {
          "label": "󰤨  Wi-Fi",
          "type": "button",
          "command": "rice-ctl wifi"
        },
        {
          "label": "󰂯  Bluetooth",
          "type": "button",
          "command": "blueman-manager"
        },
        {
          "label": "󰖔  Night Light",
          "type": "toggle",
          "active": false,
          "command": "sh -c 'if pgrep -x hyprsunset >/dev/null; then killall hyprsunset; else hyprsunset -t 4000; fi'"
        },
        {
          "label": "󰍬  Mic Mute",
          "type": "toggle",
          "active": false,
          "command": "rice-ctl volume mic-toggle"
        },
        {
          "label": "󰌌  Caffeine",
          "type": "toggle",
          "active": false,
          "command": "rice-ctl caffeine toggle"
        }
      ]
    }
  }
}

{
    "layer": "top", // Waybar at top layer
    "position": "top", // Waybar position (top|bottom|left|right)
    "height": 34,
    "spacing": 6,
    "margin-top": 6,
    "margin-left": 6,
    "margin-right": 6,
    "margin-bottom": 0,

    "modules-left": [
        "niri/workspaces",
        "mpris"
    ],

    "modules-center": [
        "custom/weather",
        "clock"
    ],

    "modules-right": [
        "custom/recorder",
        "battery",
        "group/sounds",
        "group/hw",
        "custom/dunst",
        "custom/caf-waybar"
    ],

"custom/caf-waybar": {
    "exec": "~/.local/bin/caf.sh status",
    "on-click": "~/.local/bin/caf.sh toggle",
    "return-type": "json",
    "signal": 13,
    "interval": 5,
    "tooltip": true
}, 

"niri/workspaces": {
    "on-click": "activate",
    "all-outputs": true,
    "format": "{icon}",
    "format-icons": {
        "active": "󰮯",
        "default": "󰊠",
        "empty": ""
    }
},

    "clock": {
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format": " {:%a, %d %b %H:%M}",
        "format-alt": " {:%H:%M}",
        "on-click-right": "~/.local/bin/cal.sh curr",
        "on-scroll-up": "~/.local/bin/cal.sh next",
        "on-scroll-down": "~/.local/bin/cal.sh prev"
    },

    "cpu": {
        "format": " {usage}%",
        "on-click": "kitty -e btop",
        "tooltip": false
    },

    "memory": {
        "format": " {used:0.1f}GiB"
    },

    "backlight": {
        "device": "amdgpu_bl1",
        "format": "{icon}",
        "format-icons": ["", "", ""],
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-",
        "tooltip": false
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-discharging": "{capacity}% {icon}",
        "format-full": "{capacity}% {icon}",
        "format-charging": "{capacity}% 󰂄",
        "format-plugged": "{capacity}% 󰂄",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰁹"],
        "tooltip-format": "{capacity}% - {timeTo}"
    },

    "battery#bat2": {
        "bat": "BAT2"
    },

    "bluetooth": {
        "format": "",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-connected": "󰂱",
        "format-connected-battery": "󰂱 {device_battery_percentage}%",
        "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%",
        "on-click": "blueman-manager",
        "on-click-right": "rfkill toggle bluetooth"
    },

    "network": {
        "max-length": 15,
        "format-wifi": "",
        "format-ethernet": "",
        "tooltip-format": "Network Information\n\nSSID  : {essid}\nIP    : {ipaddr}\nBand  : {frequency} MHz\nSignal: {signalStrength}%   \nvia   : {ifname}",
        "format-linked": "{ifname} (No IP) 󰊗",
        "format-disconnected": "󱛅",
        "on-click": "~/.local/bin/wifi.sh"
    },

    "pulseaudio": {
        "format": " {volume}%",
        "format-muted": "󰝟",
        "format-bluetooth": " {volume}%",
        "format-bluetooth-muted": "󰝟 ",
        "on-click": "pavucontrol"
    },

    "pulseaudio#microphone": {
        "format": "{format_source}",
        "format-source": " {volume}%",
        "format-source-muted": "",
        "on-click": "pavucontrol",
        "on-click-right": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
        "on-scroll-up": "pactl set-source-volume @DEFAULT_SOURCE@ +5%",
        "on-scroll-down": "pactl set-source-volume @DEFAULT_SOURCE@ -5%",
        "tooltip-format": "{source_desc} | {source_volume}%"
    },

    "custom/weather": {
        "format": "{}",
        "tooltip": true,
        "interval": 1800,
        "exec": "~/.local/bin/weather.sh",
        "return-type": "json"
    },

    "group/cpu": {
        "orientation": "horizontal",
        "modules": [
            "cpu"
        ]
    },

    "mpris": {
        "format": "{player_icon} {title} - {artist}",
        "max-length": 30,
        "tooltip": false,
        "format-paused": "{status_icon} <i>{title} - {artist}</i>",
        "player-icons": {
            "default": "▶"
        },
        "status-icons": {
            "paused": "⏸"
        }
    },

    "custom/dunst": {
        "format": "{}",
        "exec": "makoctl mode | grep -q dnd && echo '󰂛' || echo ''",
        "on-click": "makoctl mode -t dnd; pkill -RTMIN+8 waybar",
        "on-click-right": "makoctl dismiss -a",
        "interval": 5,
        "signal": 8,
        "tooltip-format": "Left click: Toggle DND\nRight click: Dismiss all"
    },

    "custom/recorder": {
    "format": "Rec 󰑊",
    "exec": "pgrep -x wf-recorder",
    "signal": 9
    },

    "group/hw": {
        "orientation": "horizontal",
        "modules": [
            "bluetooth",
            "network"
        ]
    },

        "group/bg": {
        "orientation": "horizontal",
        "modules": [
            "custom/steam",
            "custom/vesktop",
            "custom/spotify"
        ]
    },

    "group/sounds": {
        "orientation": "horizontal",
        "modules": [
            "pulseaudio",
            "pulseaudio#microphone",
        ]
    },
        "group/syst": {
        "orientation": "horizontal",
        "modules": [
          "cpu",
          "memory"
        ]
    }
}

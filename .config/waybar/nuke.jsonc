{
    "layer": "top", // Waybar at top layer
    "position": "top", // Waybar position (top|bottom|left|right)
    "height": 34,
    "spacing": 12,
    "margin-top": 3,
    "margin-left": 6,
    "margin-right": 6,
    "margin-bottom": 0,

    "modules-left": [
      "niri/workspaces",
      "network",
      "pulseaudio#microphone",
      "custom/caf-waybar",
      "clock"
    ],

    "modules-center": [
        "custom/ppd",
    ],

    "modules-right": [
        "battery",
        "custom/light",
        "custom/volume"
    ],

"custom/caf-waybar": {
    "exec": "~/.local/bin/caf.sh status",
    "on-click": "~/.local/bin/caf.sh toggle",
    "return-type": "json",
    "signal": 13,
    "interval": 5,
    "tooltip": true
}, 

    "memory": {
        "format": "[  {used:0.1f}GiB ]",
    },


"niri/workspaces": {
    "on-click": "activate",
    "all-outputs": true,
    "persistent-workspaces": {
        "1": [],
        "2": [],
        "3": [],
        "4": [],
        "5": []
    },
    "format": "{icon}"
},

    "clock": {
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format": "[  {:%H:%M} ]",
        "on-click-right": "~/.local/bin/cal.sh curr",
        "on-scroll-up": "~/.local/bin/cal.sh next",
        "on-scroll-down": "~/.local/bin/cal.sh prev"
    },

    "temperature": {
        // "thermal-zone": 2,
        "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
        "input-filename": "temp1_input",
        "critical-threshold": 80,
        // "format-critical": "{temperatureC}°C {icon}",
        "format": "[  {temperatureC}°C ]",
        "format-icons": ["󰉬", "", "󰉪"]
    },

    "custom/light": {
      "exec": "~/.config/waybar/nuke-script/wayback.sh",
      "signal": 19
    }, 

    "custom/ppd": {
      "exec": "~/.config/waybar/nuke-script/wayppd.sh",
      "interval": 30,
      "format": "[ {} ]",
      "signal": 21
    },

    "custom/volume": {
      "exec": "~/.config/waybar/nuke-script/wayvol.sh",
      "signal": 17
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-discharging": "{capacity}% {icon}",
        "format-full": "{capacity}% {icon}",
        "format-charging": "{capacity}% 󰂄",
        "format-plugged": "{capacity}% 󰂄",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰁹"]
    },

    "battery#bat2": {
        "bat": "BAT2"
    },

    "network": {
        "max-length": 15,
        "format-wifi": "[  ]",
        "format-ethernet": "[  ]",
        "tooltip-format": "Network Information\n\nSSID  : {essid}\nIP    : {ipaddr}\nBand  : {frequency} MHz\nSignal: {signalStrength}%   \nvia   : {ifname}",
        "format-linked": "{ifname} (No IP) 󰊗",
        "format-disconnected": "[ 󱛅 ]",
        "on-click": "~/.local/bin/wifi.sh"
    },

    "pulseaudio#microphone": {
        "format": "{format_source}",
        "format-source": "[  ]",
        "format-source-muted": "[  ]",
        "on-click": "pavucontrol",
        "on-click-right": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
        "on-scroll-up": "pactl set-source-volume @DEFAULT_SOURCE@ +5%",
        "on-scroll-down": "pactl set-source-volume @DEFAULT_SOURCE@ -5%",
        "tooltip-format": "{source_desc} | {source_volume}%"
    },


    "custom/dunst": {
    "format": "{}",
    "exec": "dunstctl is-paused | grep -q true && echo 'DND' || echo ''",
    "signal": 8
    },

    "custom/recorder": {
    "format": "Rec 󰑊",
    "exec": "pgrep -x wf-recorder",
    "signal": 9
    },
}

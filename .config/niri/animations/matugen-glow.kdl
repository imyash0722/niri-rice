/*
Shader: matugen-glow
Authors: niri-rice
Desc: Dynamic Material You border aura and smooth scale for window open/close.
*/

animations {
    slowdown 1.0

    window-open {
        duration-ms 200
        curve "ease-out-cubic"

        custom-shader r"
            const vec3 MATUGEN_COLOR = vec3(0.996, 0.722, 0.467);

            vec4 open_color(vec3 coords_geo, vec3 size_geo) {
                float p = niri_clamped_progress;
                vec2 uv = coords_geo.xy;
                
                // Scale from center
                float scale = mix(0.90, 1.0, p);
                vec2 scaled_uv = (uv - 0.5) / scale + 0.5;

                if (scaled_uv.x < 0.0 || scaled_uv.x > 1.0 || scaled_uv.y < 0.0 || scaled_uv.y > 1.0) {
                    // Border glow aura in the outer margins
                    vec2 d = abs(uv - 0.5) * 2.0;
                    float dist = max(d.x, d.y);
                    if (dist > scale && dist < scale + 0.08 * (1.0 - p)) {
                        float glow = (1.0 - p) * (1.0 - (dist - scale) / (0.08 * (1.0 - p) + 0.001));
                        return vec4(MATUGEN_COLOR * glow, glow * 0.8);
                    }
                    return vec4(0.0);
                }

                vec3 coords_tex = niri_geo_to_tex * vec3(scaled_uv, 1.0);
                vec4 tex = texture2D(niri_tex, coords_tex.st);
                
                // Accent flash / tint during the initial burst
                float flash = (1.0 - p) * 0.4;
                tex.rgb = mix(tex.rgb, MATUGEN_COLOR, flash);
                tex.a *= p;

                return tex;
            }
        "
    }

    window-close {
        duration-ms 170
        curve "ease-out-cubic"

        custom-shader r"
            const vec3 MATUGEN_COLOR = vec3(0.996, 0.722, 0.467);

            vec4 close_color(vec3 coords_geo, vec3 size_geo) {
                float p = niri_clamped_progress; // 0.0 = starting to close, 1.0 = fully closed
                vec2 uv = coords_geo.xy;

                float scale = mix(1.0, 0.88, p);
                vec2 scaled_uv = (uv - 0.5) / scale + 0.5;

                if (scaled_uv.x < 0.0 || scaled_uv.x > 1.0 || scaled_uv.y < 0.0 || scaled_uv.y > 1.0) {
                    // Edge aura dissipation
                    vec2 d = abs(uv - 0.5) * 2.0;
                    float dist = max(d.x, d.y);
                    if (dist > scale && dist < scale + 0.06 * p) {
                        float glow = (1.0 - p) * (1.0 - (dist - scale) / (0.06 * p + 0.001));
                        return vec4(MATUGEN_COLOR * glow, glow * 0.7);
                    }
                    return vec4(0.0);
                }

                vec3 coords_tex = niri_geo_to_tex * vec3(scaled_uv, 1.0);
                vec4 tex = texture2D(niri_tex, coords_tex.st);
                
                float aura = p * 0.5;
                tex.rgb = mix(tex.rgb, MATUGEN_COLOR, aura);
                tex.a *= (1.0 - p);

                return tex;
            }
        "
    }
}

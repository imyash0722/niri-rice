[Unit]
Description=Niri Radial Dial Ultra-Fast Resident Daemon
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
Environment=PYTHONPATH=/mnt/shared/stuff/projects/niri-radial-dial
Environment=WAYLAND_DISPLAY=wayland-1
EnvironmentFile=-%h/.config/environment.d/10-kde-qt.conf
EnvironmentFile=-%h/.config/environment.d/10-cursor.conf
ExecStart=/usr/bin/python3 -m niri_radial_dial.main daemon
Restart=always
RestartSec=1s

[Install]
WantedBy=default.target

[Unit]
Description=Niri Radial Dial Ultra-Fast Resident Daemon
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
Environment=PYTHONPATH=/mnt/shared/stuff/projects/niri-radial-dial
ExecStart=/usr/bin/python3 -m niri_radial_dial.main daemon
Restart=on-failure
RestartSec=1s

[Install]
WantedBy=graphical-session.target

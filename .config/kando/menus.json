                    "name": "GitHub",
                    "icon": "code",
                    "iconTheme": "material-symbols-rounded",
                    "type": "button",
                    "selectWorkflow": { "actions": [{ "type": "execute-command", "command": "xdg-open https://github.com" }] }
                  },
                  {
                    "name": "YouTube",
                    "icon": "smart_display",
                    "iconTheme": "material-symbols-rounded",
                    "type": "button",
                    "selectWorkflow": { "actions": [{ "type": "execute-command", "command": "xdg-open https://youtube.com" }] }

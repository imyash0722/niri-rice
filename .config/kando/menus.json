              {
                "name": "Network Settings",
                "icon": "settings",
                "iconTheme": "material-symbols-rounded",
                "type": "button",
                "selectWorkflow": { "actions": [{ "type": "execute-command", "command": "kitty --class kitty.nmtui -e nmtui" }] }

                "name": "Performance",
                "icon": "bolt",
                "iconTheme": "material-symbols-rounded",
                "type": "button",
                "selectWorkflow": { "actions": [{ "type": "execute-command", "command": "powerprofilesctl set performance" }] }
              },
              {
                "name": "Balanced",
                "icon": "balance",
                "iconTheme": "material-symbols-rounded",
                "type": "button",
                "selectWorkflow": { "actions": [{ "type": "execute-command", "command": "powerprofilesctl set balanced" }] }
              },
              {
                "name": "Power Saver",
                "icon": "battery_saver",
                "iconTheme": "material-symbols-rounded",
                "type": "button",
                "selectWorkflow": { "actions": [{ "type": "execute-command", "command": "powerprofilesctl set power-saver" }] }
              },
              {
                "name": "Caffeine Toggle",
                "icon": "coffee",
                "iconTheme": "material-symbols-rounded",
                "type": "button",
                "selectWorkflow": { "actions": [{ "type": "execute-command", "command": "rice-ctl caffeine toggle" }] }
              },
              {
                "name": "DND Toggle",
                "icon": "notifications_off",
                "iconTheme": "material-symbols-rounded",
                "type": "button",
                "selectWorkflow": { "actions": [{ "type": "execute-command", "command": "makoctl mode -t dnd" }] }
              }
            ]
          },

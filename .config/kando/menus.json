                    "name": "Reddit",
                    "icon": "forum",
                    "iconTheme": "material-symbols-rounded",
                    "type": "button",
                    "selectWorkflow": { "actions": [{ "type": "execute-command", "command": "xdg-open https://reddit.com" }] }

              {
                "name": "Mute Audio",
                "icon": "volume_off",
                "iconTheme": "material-symbols-rounded",
                "type": "button",
                "selectWorkflow": { "actions": [{ "type": "execute-command", "command": "rice-ctl volume mute-toggle" }] }
              },
              {
                "name": "Mute Mic",
                "icon": "mic_off",
                "iconTheme": "material-symbols-rounded",
                "type": "button",
                "selectWorkflow": { "actions": [{ "type": "execute-command", "command": "rice-ctl volume mic-mute-toggle" }] }
              }
            ]
          },
          {
            "name": "Profiles",
            "icon": "speed",
            "iconTheme": "material-symbols-rounded",
            "type": "submenu",
            "children": [

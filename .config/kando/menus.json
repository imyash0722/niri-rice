                    "name": "Tinarchy",
                    "icon": "terminal",
                    "iconTheme": "material-symbols-rounded",
                    "type": "button",
                    "selectWorkflow": { "actions": [{ "type": "execute-command", "command": "kitty -e ssh tinarchy" }] }
                  }

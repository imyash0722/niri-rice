                "name": "Toggle Wi-Fi",
                "icon": "wifi_off",
                "iconTheme": "material-symbols-rounded",
                "type": "button",
                "selectWorkflow": { "actions": [{ "type": "execute-command", "command": "nmcli radio wifi | grep -qi 'enabled' && nmcli radio wifi off || nmcli radio wifi on" }] }
              },
              {
                "name": "Disconnect Wi-Fi",
                "icon": "link_off",
                "iconTheme": "material-symbols-rounded",
                "type": "button",
                "selectWorkflow": { "actions": [{ "type": "execute-command", "command": "nmcli device disconnect wlan0" }] }

                    "name": "Gemini",
                    "icon": "auto_awesome",
                    "iconTheme": "material-symbols-rounded",
                    "type": "button",
                    "selectWorkflow": { "actions": [{ "type": "execute-command", "command": "xdg-open https://gemini.google.com" }] }
                  },
                  {
                    "name": "ArchWiki",
                    "icon": "menu_book",
                    "iconTheme": "material-symbols-rounded",
                    "type": "button",
                    "selectWorkflow": { "actions": [{ "type": "execute-command", "command": "xdg-open https://wiki.archlinux.org" }] }
                  }
                ]
              },

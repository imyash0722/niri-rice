            "icon": "star",
            "iconTheme": "material-symbols-rounded",
            "type": "submenu",
            "children": [
              {
                "name": "Browser",
                "icon": "globe",
                "iconTheme": "material-symbols-rounded",
                "type": "button",
                "selectWorkflow": { "actions": [{ "type": "execute-command", "command": "zen-browser || firefox" }] }
              },
              {
                "name": "Terminal",
                "icon": "terminal",
                "iconTheme": "material-symbols-rounded",
                "type": "button",
                "selectWorkflow": { "actions": [{ "type": "execute-command", "command": "kitty" }] }
              },
              {
                "name": "Code Editor",
                "icon": "code",
                "iconTheme": "material-symbols-rounded",
                "type": "button",
                "selectWorkflow": { "actions": [{ "type": "execute-command", "command": "kate" }] }
              },
              {
                "name": "File Manager",
                "icon": "folder",
                "iconTheme": "material-symbols-rounded",
                "type": "button",
                "selectWorkflow": { "actions": [{ "type": "execute-command", "command": "dolphin" }] }
              },
              {
                "name": "Discord",
                "icon": "forum",
                "iconTheme": "material-symbols-rounded",
                "type": "button",
                "selectWorkflow": { "actions": [{ "type": "execute-command", "command": "vesktop" }] }
              },
              {
                "name": "Music",
                "icon": "music_note",
                "iconTheme": "material-symbols-rounded",
                "type": "button",
                "selectWorkflow": { "actions": [{ "type": "execute-command", "command": "spotify" }] }
              },
              {
                "name": "Search All Apps...",
                "icon": "search",
                "iconTheme": "material-symbols-rounded",
                "type": "button",
                "selectWorkflow": { "actions": [{ "type": "execute-command", "command": "rofi -show drun" }] }
              }
            ]
          },
          {
            "name": "Media",
            "icon": "play_arrow",
            "iconTheme": "material-symbols-rounded",
            "type": "submenu",
            "children": [
              {
                "name": "Play / Pause",
                "icon": "play_circle",
                "iconTheme": "material-symbols-rounded",
                "type": "button",
                "selectWorkflow": { "actions": [{ "type": "execute-command", "command": "playerctl play-pause" }] }
              },
              {
                "name": "Next Track",
                "icon": "skip_next",
                "iconTheme": "material-symbols-rounded",
                "type": "button",
                "selectWorkflow": { "actions": [{ "type": "execute-command", "command": "playerctl next" }] }
              },
              {
                "name": "Prev Track",
                "icon": "skip_previous",
                "iconTheme": "material-symbols-rounded",
                "type": "button",
                "selectWorkflow": { "actions": [{ "type": "execute-command", "command": "playerctl previous" }] }

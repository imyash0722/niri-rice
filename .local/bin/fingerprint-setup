#!/usr/bin/env bash
# ==============================================================================
# Fingerprint Setup & Management Utility
# ==============================================================================

set -e

GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m' # No Color

clear
echo -e "${BLUE}======================================================${NC}"
echo -e "${BLUE}       Fingerprint Scanner Setup & Management         ${NC}"
echo -e "${BLUE}======================================================${NC}"
echo ""

# Check device detection
echo -e "${YELLOW}[1] Detecting Fingerprint Scanner...${NC}"
DEVICE=$(fprintd-list "$USER" 2>&1 || true)
if echo "$DEVICE" | grep -q "found 1 devices"; then
    echo -e "${GREEN}✓ Scanner Detected: Elan MOC Fingerprint Sensor${NC}"
else
    echo -e "${RED}✗ No supported fingerprint scanner detected by fprintd.${NC}"
    exit 1
fi

echo ""
echo -e "${YELLOW}[2] Currently Enrolled Fingers for user '$USER':${NC}"
fprintd-list "$USER" || echo "No fingers enrolled yet."

echo ""
echo -e "${BLUE}======================================================${NC}"
echo "What would you like to do?"
echo "  1) Enroll Right Index Finger (Recommended)"
echo "  2) Enroll Right Thumb"
echo "  3) Enroll Left Index Finger"
echo "  4) Enroll a custom finger"
echo "  5) Test / Verify enrolled fingerprint"
echo "  6) Open Graphical Settings (KDE User Accounts)"
echo "  7) Delete all enrolled fingers"
echo "  8) Exit"
echo -e "${BLUE}======================================================${NC}"

read -rp "Select an option [1-8]: " choice

case "$choice" in
    1)
        echo -e "\n${GREEN}Enrolling Right Index Finger...${NC}"
        echo "Place your right index finger on the power button sensor repeatedly when prompted."
        fprintd-enroll -f right-index-finger "$USER"
        ;;
    2)
        echo -e "\n${GREEN}Enrolling Right Thumb...${NC}"
        echo "Place your right thumb on the sensor repeatedly when prompted."
        fprintd-enroll -f right-thumb "$USER"
        ;;
    3)
        echo -e "\n${GREEN}Enrolling Left Index Finger...${NC}"
        echo "Place your left index finger on the sensor repeatedly when prompted."
        fprintd-enroll -f left-index-finger "$USER"
        ;;
    4)
        echo -e "\nAvailable finger names: right-thumb, right-index-finger, right-middle-finger, right-ring-finger, right-little-finger, left-thumb, left-index-finger, left-middle-finger, left-ring-finger, left-little-finger"
        read -rp "Enter finger name: " custom_finger
        fprintd-enroll -f "$custom_finger" "$USER"
        ;;
    5)
        echo -e "\n${BLUE}Place your enrolled finger on the sensor to test...${NC}"
        fprintd-verify "$USER"
        ;;
    6)
        echo -e "\nOpening KDE User Settings GUI..."
        kcmshell6 kcm_users &
        ;;
    7)
        read -rp "Are you sure you want to delete all fingerprints? [y/N]: " confirm
        if [[ "$confirm" =~ ^[Yy]$ ]]; then
            fprintd-delete "$USER"
            echo -e "${GREEN}All fingerprints deleted.${NC}"
        fi
        ;;
    *)
        echo "Exiting."
        exit 0
        ;;
esac

echo ""
echo -e "${GREEN}✓ Setup complete! You can now use your fingerprint for:${NC}"
echo "  - Sudo in terminal (sudo <cmd>)"
echo "  - Graphical authentication dialogs (Polkit)"
echo "  - Login screen (SDDM)"
echo "  - Lock screen"
echo ""

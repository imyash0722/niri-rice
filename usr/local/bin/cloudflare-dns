#!/usr/bin/env bash
# /usr/local/bin/cloudflare-dns - Toggle Cloudflare 1.1.1.1 DNS

CONF_FILE="/etc/systemd/resolved.conf.d/cloudflare.conf"
DISABLED_FILE="/etc/systemd/resolved.conf.d/cloudflare.conf.disabled"

is_enabled() {
    [[ -f "$CONF_FILE" ]]
}

enable_dns() {
    mkdir -p /etc/systemd/resolved.conf.d
    cat << "CONFEOF" > "$CONF_FILE"
[Resolve]
DNS=1.1.1.1#cloudflare-dns.com 1.0.0.1#cloudflare-dns.com 2606:4700:4700::1111#cloudflare-dns.com 2606:4700:4700::1001#cloudflare-dns.com
FallbackDNS=8.8.8.8#dns.google 9.9.9.9#dns.quad9.net
Domains=~.
DNSOverTLS=opportunistic
CONFEOF
    rm -f "$DISABLED_FILE"
    systemctl reload systemd-resolved
}

disable_dns() {
    if [[ -f "$CONF_FILE" ]]; then
        mv "$CONF_FILE" "$DISABLED_FILE"
    fi
    systemctl reload systemd-resolved
}

case "$1" in
    status)
        if is_enabled; then
            echo "enabled"
        else
            echo "disabled"
        fi
        exit 0
        ;;
    enable)
        enable_dns
        echo "enabled"
        ;;
    disable)
        disable_dns
        echo "disabled"
        ;;
    toggle)
        if is_enabled; then
            disable_dns
            echo "disabled"
        else
            enable_dns
            echo "enabled"
        fi
        ;;
    *)
        echo "Usage: $0 {status|enable|disable|toggle}"
        exit 2
        ;;
esac
